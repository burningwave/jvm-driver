<!--
	JMH benchmark that compares the JNI engine of Burningwave (org.burningwave.jni.Executor, in the jni-executor
	artifact) with Narcissus (io.github.toolfactory.narcissus.Narcissus), using sun.misc.Unsafe, standard reflection,
	VarHandle and the default driver of ToolFactory JVM Driver as reference. It also measures the native driver of
	ToolFactory JVM Driver, which uses the JNI engine of Burningwave. The names of the benchmarks follow the ones of the
	benchmark published in 2022 in https://github.com/toolfactory/narcissus/discussions/11.

	This project is not a module of the parent project: it is never built by the release. By default it depends on the
	release of JNI Executor set in the jni-executor.version property, which Maven downloads from Maven Central with
	ToolFactory JVM Driver:

		mvn package -f benchmark/pom.xml
		java -jar benchmark/target/benchmarks.jar

	To measure the code of this repository, build the native library of your platform, install the jni-executor module
	and pass its version with -Djni-executor.version=<version>, as the '[M] benchmark' workflow does:

		mvn compile -f native/pom.xml
		mvn install -Dproject_jdk_version=8 -DskipTests=true -f jni-executor/pom.xml
		mvn package -f benchmark/pom.xml -Djni-executor.version=<version>
		java -jar benchmark/target/benchmarks.jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.burningwave</groupId>
	<artifactId>jvm-driver-benchmark</artifactId>
	<version>1.0.0-SNAPSHOT</version>

	<packaging>jar</packaging>

	<name>Burningwave JVM Driver - Benchmark</name>
	<description>JMH benchmark that compares the Burningwave JNI engine with Narcissus</description>
	<url>https://burningwave.github.io/jvm-driver/</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://github.com/burningwave/jvm-driver/blob/main/LICENSE</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- VarHandle and MethodHandles.privateLookupIn require Java 9: 11 is the oldest LTS that has them -->
		<maven.compiler.release>11</maven.compiler.release>
		<maven.deploy.skip>true</maven.deploy.skip>

		<!-- A release published on Maven Central: the '[M] benchmark' workflow passes the version of the jni-executor
		module of the commit -->
		<jni-executor.version>1.1.1</jni-executor.version>
		<!-- Since version 10 the native driver of ToolFactory JVM Driver uses the JNI engine of Burningwave by default -->
		<toolfactory-jvm-driver.version>10.1.1</toolfactory-jvm-driver.version>
		<narcissus.version>1.0.14</narcissus.version>
		<jmh.version>1.37</jmh.version>

		<maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
		<maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
		<uberjar.name>benchmarks</uberjar.name>
	</properties>

	<dependencies>

		<!-- ToolFactory JVM Driver depends on this artifact too: its native driver uses the version set here -->
		<dependency>
			<groupId>org.burningwave</groupId>
			<artifactId>jni-executor</artifactId>
			<version>${jni-executor.version}</version>
		</dependency>

		<!-- The default and native drivers measured through the Driver interface, see Drivers -->
		<dependency>
			<groupId>io.github.toolfactory</groupId>
			<artifactId>jvm-driver</artifactId>
			<version>${toolfactory-jvm-driver.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.toolfactory</groupId>
			<artifactId>narcissus</artifactId>
			<version>${narcissus.version}</version>
		</dependency>

		<dependency>
			<groupId>org.openjdk.jmh</groupId>
			<artifactId>jmh-core</artifactId>
			<version>${jmh.version}</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven-compiler-plugin.version}</version>
				<configuration>
					<!-- Declared explicitly because javac 23 and later no longer run the annotation processors found
					on the class path -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.openjdk.jmh</groupId>
							<artifactId>jmh-generator-annprocess</artifactId>
							<version>${jmh.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>${maven-shade-plugin.version}</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>${uberjar.name}</finalName>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>org.openjdk.jmh.Main</mainClass>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<!-- The uber jar runs on the class path -->
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/*/module-info.class</exclude>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
